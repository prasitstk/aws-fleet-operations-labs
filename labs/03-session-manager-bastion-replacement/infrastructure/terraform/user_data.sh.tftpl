#!/bin/bash
# -----------------------------------------------------------------------------
# Lab 03: Runtime parameter resolution via SSM Parameter Store (VPC endpoints)
# This script runs at EC2 boot time, reading configuration from Parameter Store
# through VPC endpoints (no internet access required).
# Demonstrates that private instances can access SSM services via endpoints.
# -----------------------------------------------------------------------------

set -euo pipefail

PARAM_PREFIX="${param_prefix}"
AWS_REGION="${aws_region}"
CONFIG_DIR="/opt/app"
CONFIG_FILE="$CONFIG_DIR/config.env"

echo "=== SSM Parameter Store Runtime Configuration ==="
echo "Reading parameters from: $PARAM_PREFIX"

mkdir -p "$CONFIG_DIR"

# Read application configuration parameters
IDLE_TIMEOUT=$(aws ssm get-parameter \
  --name "$PARAM_PREFIX/config/idle-timeout" \
  --region "$AWS_REGION" \
  --query "Parameter.Value" --output text)

ALLOWED_COMMANDS=$(aws ssm get-parameter \
  --name "$PARAM_PREFIX/config/allowed-commands" \
  --region "$AWS_REGION" \
  --query "Parameter.Value" --output text)

# Read secrets (decrypted via KMS VPC endpoint)
DB_PASSWORD=$(aws ssm get-parameter \
  --name "$PARAM_PREFIX/secrets/db-password" \
  --with-decryption \
  --region "$AWS_REGION" \
  --query "Parameter.Value" --output text)

# Write config file (secrets masked in logs but available to application)
cat > "$CONFIG_FILE" <<EOF
# Generated by SSM Parameter Store at boot time
# Source: $PARAM_PREFIX
# Timestamp: $(date -u +"%Y-%m-%dT%H:%M:%SZ")

IDLE_TIMEOUT=$IDLE_TIMEOUT
ALLOWED_COMMANDS=$ALLOWED_COMMANDS
DB_PASSWORD=$DB_PASSWORD
EOF

chmod 600 "$CONFIG_FILE"

echo "=== Configuration written to $CONFIG_FILE ==="
echo "IDLE_TIMEOUT=$IDLE_TIMEOUT"
echo "ALLOWED_COMMANDS=$ALLOWED_COMMANDS"
echo "DB_PASSWORD=****" # masked
echo "=== Runtime parameter resolution complete ==="
