#!/bin/bash
# -----------------------------------------------------------------------------
# Lab 04: Runtime parameter resolution via SSM Parameter Store
# This script runs at EC2 boot time, reading configuration from Parameter Store.
# Demonstrates the difference between deploy-time resolution (AMI, instance type
# baked into Terraform plan) and runtime resolution (config read at boot).
# -----------------------------------------------------------------------------

set -euo pipefail

PARAM_PREFIX="${param_prefix}"
AWS_REGION="${aws_region}"
CONFIG_DIR="/opt/app"
CONFIG_FILE="$CONFIG_DIR/config.env"

echo "=== SSM Parameter Store Runtime Configuration ==="
echo "Reading parameters from: $PARAM_PREFIX"

mkdir -p "$CONFIG_DIR"

# Read application configuration parameters
LOG_LEVEL=$(aws ssm get-parameter \
  --name "$PARAM_PREFIX/app/log-level" \
  --region "$AWS_REGION" \
  --query "Parameter.Value" --output text)

FEATURE_FLAGS=$(aws ssm get-parameter \
  --name "$PARAM_PREFIX/app/feature-flags" \
  --region "$AWS_REGION" \
  --query "Parameter.Value" --output text)

ENVIRONMENT=$(aws ssm get-parameter \
  --name "$PARAM_PREFIX/app/environment" \
  --region "$AWS_REGION" \
  --query "Parameter.Value" --output text)

# Read secrets (decrypted via KMS)
DB_CONNECTION=$(aws ssm get-parameter \
  --name "$PARAM_PREFIX/secrets/db-connection-string" \
  --with-decryption \
  --region "$AWS_REGION" \
  --query "Parameter.Value" --output text)

API_KEY=$(aws ssm get-parameter \
  --name "$PARAM_PREFIX/secrets/api-key" \
  --with-decryption \
  --region "$AWS_REGION" \
  --query "Parameter.Value" --output text)

# Write config file (secrets masked in logs but available to application)
cat > "$CONFIG_FILE" <<EOF
# Generated by SSM Parameter Store at boot time
# Source: $PARAM_PREFIX
# Timestamp: $(date -u +"%Y-%m-%dT%H:%M:%SZ")

ENVIRONMENT=$ENVIRONMENT
LOG_LEVEL=$LOG_LEVEL
FEATURE_FLAGS=$FEATURE_FLAGS
DB_CONNECTION_STRING=$DB_CONNECTION
API_KEY=$API_KEY
EOF

chmod 600 "$CONFIG_FILE"

echo "=== Configuration written to $CONFIG_FILE ==="
echo "ENVIRONMENT=$ENVIRONMENT"
echo "LOG_LEVEL=$LOG_LEVEL"
echo "FEATURE_FLAGS=$FEATURE_FLAGS"
echo "DB_CONNECTION_STRING=****" # masked
echo "API_KEY=****"              # masked
echo "=== Runtime parameter resolution complete ==="
